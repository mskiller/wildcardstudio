# Paths mounted by docker-compose.yml
WILDCARDS_PATH=/data/wildcards
DB_PATH=/data/db/wildcardstudio.db
BACKUPS_PATH=/data/backups

# Backend
LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=50

# Fuzzy matching
DEFAULT_SIMILARITY_THRESHOLD=85

# Backups
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_KEEP_LAST=7

# Token counting
TOKEN_MODEL=cl100k_base

# Git versioning inside the app
GIT_ENABLED=true
GIT_AUTO_COMMIT=false
GIT_USER_NAME=WildcardStudio
GIT_USER_EMAIL=local@wildcardstudio.local
